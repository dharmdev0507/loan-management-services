<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions
    xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:camunda="http://camunda.org/schema/1.0/bpmn"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    id="LoanDefinitions"
    targetNamespace="http://loan.com">

    <bpmn:process id="loanLifecycle"
                  name="Loan Lifecycle"
                  isExecutable="true"
                  camunda:historyTimeToLive="180">

        <bpmn:startEvent id="start"
                         name="Loan Submitted"/>

        <bpmn:sequenceFlow id="flow1"
                           sourceRef="start"
                           targetRef="eligibility"/>

        <bpmn:serviceTask
            id="eligibility"
            name="Check Eligibility"
            camunda:delegateExpression=
                "${eligibilityDelegate}"/>

        <bpmn:sequenceFlow id="flow2"
                           sourceRef="eligibility"
                           targetRef="eligibilityGateway"/>

        <bpmn:exclusiveGateway
            id="eligibilityGateway"
            name="Eligible?"/>

        <bpmn:sequenceFlow id="flow3"
                           sourceRef="eligibilityGateway"
                           targetRef="managerApproval">
            <bpmn:conditionExpression
                xsi:type="bpmn:tFormalExpression">
                ${eligible == true}
            </bpmn:conditionExpression>
        </bpmn:sequenceFlow>

        <bpmn:sequenceFlow id="flow4"
                           sourceRef="eligibilityGateway"
                           targetRef="eligibilityRejected">
            <bpmn:conditionExpression
                xsi:type="bpmn:tFormalExpression">
                ${eligible == false}
            </bpmn:conditionExpression>
        </bpmn:sequenceFlow>

        <bpmn:userTask
            id="managerApproval"
            name="Credit Manager Approval"
            camunda:candidateGroups="CREDIT_MANAGER"/>

        <bpmn:sequenceFlow id="flow5"
                           sourceRef="managerApproval"
                           targetRef="approvalGateway"/>

        <bpmn:exclusiveGateway
            id="approvalGateway"
            name="Approval Decision?"/>

        <bpmn:sequenceFlow id="flow6"
                           sourceRef="approvalGateway"
                           targetRef="markApproved">
            <bpmn:conditionExpression
                xsi:type="bpmn:tFormalExpression">
                ${approved == true}
            </bpmn:conditionExpression>
        </bpmn:sequenceFlow>

        <bpmn:sequenceFlow id="flow7"
                           sourceRef="approvalGateway"
                           targetRef="managerRejected">
            <bpmn:conditionExpression
                xsi:type="bpmn:tFormalExpression">
                ${approved == false}
            </bpmn:conditionExpression>
        </bpmn:sequenceFlow>

        <bpmn:serviceTask
            id="markApproved"
            name="Mark Loan Approved"
            camunda:delegateExpression=
                "${approvalDelegate}"/>

        <bpmn:sequenceFlow id="flow8"
                           sourceRef="markApproved"
                           targetRef="disbursement"/>

        <bpmn:serviceTask
            id="disbursement"
            name="Disburse Loan"
            camunda:delegateExpression=
                "${disbursementDelegate}"/>

        <bpmn:sequenceFlow id="flow9"
                           sourceRef="disbursement"
                           targetRef="completed"/>

        <bpmn:endEvent id="completed"
                       name="Loan Disbursed"/>

        <bpmn:serviceTask
            id="managerRejected"
            name="Reject Loan"
            camunda:delegateExpression=
                "${rejectionDelegate}"/>

        <bpmn:sequenceFlow id="flow10"
                           sourceRef="managerRejected"
                           targetRef="rejectedEnd"/>

        <bpmn:endEvent id="rejectedEnd"
                       name="Loan Rejected"/>

        <bpmn:serviceTask
            id="eligibilityRejected"
            name="Eligibility Rejected"
            camunda:delegateExpression=
                "${rejectionDelegate}"/>

        <bpmn:sequenceFlow id="flow11"
                           sourceRef="eligibilityRejected"
                           targetRef="eligibilityRejectedEnd"/>

        <bpmn:endEvent id="eligibilityRejectedEnd"
                       name="Application Rejected"/>

    </bpmn:process>
</bpmn:definitions>